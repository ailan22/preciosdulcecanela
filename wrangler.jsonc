// Ambiente DEV en Cloudflare: https://precios-dulce-canela.ailanquinteroh.workers.dev
// Se publica con ./deploy-dev.sh
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "precios-dulce-canela",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "dev-build",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Base de insumos: el calculador la lee desde /api/insumos.
  // Para cambiar precios: panel de Cloudflare → D1 → dulce-canela → Console.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dulce-canela",
      "database_id": "c623fc11-304a-490b-b60d-cdbd41702cbf"
    }
  ]
}
